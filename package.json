{
  "name": "@codesys/mcp-toolkit",
  "version": "2.0.0",
  "description": "MCP server for CODESYS V3.5: read, write and compile Structured Text through a persistent CODESYS session",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "codesys-mcp-tool": "dist/cli.js"
  },
  "files": [
    "dist/",
    "watcher/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build-panel.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p panel/tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run test/live",
    "start": "node dist/cli.js",
    "build:panel": "node scripts/build-panel.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codesys",
    "mcp",
    "modelcontextprotocol",
    "plc",
    "iec-61131-3",
    "structured-text"
  ],
  "author": "Johannes Pettersson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannesPettersson80/codesys-mcp-toolkit.git"
  },
  "homepage": "https://github.com/johannesPettersson80/codesys-mcp-toolkit#readme",
  "bugs": {
    "url": "https://github.com/johannesPettersson80/codesys-mcp-toolkit/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "win32"
  ],
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
